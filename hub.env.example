# Copy to hub.env; plain KEY=value data, not shell. Use absolute paths.
HUB_DIRECTORY=/opt/edgelab-hub
REGISTRY=https://registry.example.net
REPOSITORY=team/app
ALLOW=^v.*$
REGISTRY_USERNAME=
# File containing only registry password/token; chmod 600. Never put the value here.
REGISTRY_PASSWORD_FILE=
HUB_PORT=8080
# Optional independent Linux host-network Caddy wrapper (make mtls-init).
MTLS_DIRECTORY=/opt/edgelab-mtls
MTLS_HOST=hub.example.net
MTLS_PORT=8443
