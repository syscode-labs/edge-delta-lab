# Copy to hub.env; plain KEY=value data, not shell. No $HOME or command expansion.
# Installation directories accept ~/ (the invoking user's home) or absolute paths.
# Leave these directories nonexistent for first setup; provision only their parent.
HUB_DIRECTORY=~/edgelab-hub
REGISTRY=https://registry.example.net
REGISTRY_ALLOW_HTTP=false
REPOSITORY=team/app
ALLOW=^v.*$
REGISTRY_USERNAME=
# File containing only registry password/token; chmod 600. Never put the value here.
REGISTRY_PASSWORD_FILE=
HUB_PORT=8080
# Optional independent Linux host-network Caddy wrapper (make mtls-init).
MTLS_DIRECTORY=~/edgelab-mtls
MTLS_HOST=hub.example.net
MTLS_PORT=8443
