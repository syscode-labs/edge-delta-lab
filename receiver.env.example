# Copy to receiver.env. Plain KEY=value, no shell expansion. Use absolute paths.
HUB_URL=https://hub.example.net:8443
DEVICE_ID=edge-01
PUBLISHER_PUBLIC_KEY=/etc/edgelab-enrollment/publisher.pub
# For the optional Caddy mTLS wrapper, copy only this client's enrollment files.
HUB_CA=/etc/edgelab-enrollment/hub-ca.pem
HUB_CLIENT_CERT=/etc/edgelab-enrollment/client.pem
HUB_CLIENT_KEY=/etc/edgelab-enrollment/client.key
# Empty all three TLS paths when using a different publicly trusted HTTPS proxy.
ALLOW_HTTP=false
# Optional root-equivalent Docker socket access; import is NOT activation.
DOCKER_LOAD=false
