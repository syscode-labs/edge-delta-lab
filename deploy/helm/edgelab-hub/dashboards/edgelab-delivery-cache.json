    {"id":4,"type":"timeseries","title":"Integrity (verified chunks vs zero failures)","gridPos":{"x":12,"y":8,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"${datasource}"},"targets":[{"expr":"edgelab_client_verified_chunks_total{job=\"edgelab\",instance=\"orbstack-client\"}","refId":"A","legendFormat":"verified chunks"},{"expr":"edgelab_client_integrity_failures_total{job=\"edgelab\",instance=\"orbstack-client\"}","refId":"B","legendFormat":"integrity failures"}]},
