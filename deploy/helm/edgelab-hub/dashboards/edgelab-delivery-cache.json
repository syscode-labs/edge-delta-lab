    {"id":2,"type":"timeseries","title":"Chunks per sync (transferred vs reused)","gridPos":{"x":12,"y":0,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"${datasource}"},"targets":[{"expr":"edgelab_client_last_sync_verified_chunks{job=\"edgelab\",instance=\"orbstack-client\"}","refId":"A","legendFormat":"verified chunks"},{"expr":"edgelab_client_last_sync_reused_chunks{job=\"edgelab\",instance=\"orbstack-client\"}","refId":"B","legendFormat":"reused chunks"}]},
