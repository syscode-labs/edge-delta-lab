    {"id":6,"type":"stat","title":"Exporter / source health","gridPos":{"x":6,"y":15,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"${datasource}"},"targets":[{"expr":"min(edgelab_source_up{job=\"edgelab\"})","refId":"A"}]},
    {"id":7,"type":"timeseries","title":"Snapshot age","gridPos":{"x":12,"y":15,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"${datasource}"},"targets":[{"expr":"time() - edgelab_snapshot_last_success_timestamp_seconds{job=\"edgelab\"}","refId":"A","legendFormat":"{{instance}}"}],"fieldConfig":{"defaults":{"unit":"s"}}},
    {"id":8,"type":"timeseries","title":"Cache occupancy and activity","gridPos":{"x":18,"y":15,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"${datasource}"},"targets":[{"expr":"sum(edgelab_hub_cache_bytes{job=\"edgelab\"}) / clamp_min(sum(edgelab_hub_cache_capacity_bytes{job=\"edgelab\"}),1)","refId":"A","legendFormat":"occupancy"},{"expr":"sum(rate(edgelab_hub_cache_hits_total{job=\"edgelab\"}[1m]))","refId":"B","legendFormat":"cache hits/s"},{"expr":"sum(rate(edgelab_hub_disk_reads_total{job=\"edgelab\"}[1m]))","refId":"C","legendFormat":"disk reads/s"}]},
    {"id":9,"type":"timeseries","title":"Requests and retries","gridPos":{"x":0,"y":20,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"${datasource}"},"targets":[{"expr":"sum by (instance,kind) (rate(edgelab_client_requests_total{job=\"edgelab\"}[1m]))","refId":"A","legendFormat":"client {{instance}} {{kind}}"},{"expr":"sum(rate(edgelab_client_retries_total{job=\"edgelab\"}[1m]))","refId":"B","legendFormat":"retries/s"}]},
    {"id":10,"type":"timeseries","title":"Hub body throughput","gridPos":{"x":12,"y":20,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"${datasource}"},"targets":[{"expr":"sum by (kind) (rate(edgelab_hub_response_body_bytes_total{job=\"edgelab\"}[1m]))","refId":"A","legendFormat":"{{kind}}"}],"fieldConfig":{"defaults":{"unit":"Bps"}}}
  ]
